# Backend API & Checkout URLs
REACT_APP_API_URL=https://api.example.com/api/v1
REACT_APP_BASE_URL=https://api.example.com/api/v1
REACT_APP_CHECKOUT_URL=https://example.com/payment/checkout

# Shopify Configuration (Store / SSO)
REACT_APP_SHOPIFY_USER_STORE_ID=your_store_id
REACT_APP_SHOPIFY_SSO_CUSTOMER_ID=0000
REACT_APP_SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com

# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id
REACT_APP_FIREBASE_VAPID_KEY=your_vapid_key_here

# Google Maps API Key
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Stripe Configuration
REACT_APP_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

